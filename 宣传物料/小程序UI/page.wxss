/* =====================================================================
   数境 · 夜航 —— 页面层组件 page.wxss
   顶栏 HUD / chip / 面板卡片 / 反馈状态玻璃 / 全屏浮层（唯一允许的模糊）
   令牌全部来自 app.wxss 的 page{}，这里不重复定义。
   ===================================================================== */

/* —— 顶栏 HUD ——
   常驻压在游戏地图（持续重绘的 canvas 2d，同层渲染原生组件）之上：
   容器 pointer-events:none 放行地图拖拽，可点元素单独恢复。
   红线 1：压在重绘画面上的 HUD 禁止 backdrop-filter —— canvas 2d 同层渲染，
   iOS 上 backdrop-filter 对它经常不生效或表现异常，质感靠 face-deep 撑。 */
.topbar {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 16rpx);
  left: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  pointer-events: none;
}
.topbar .btn--ico { pointer-events: auto; margin-left: auto; }

/* —— chip ——
   红线 1 + 3：chip 属于 HUD，也常出现在滚动列表里 —— 两种场景都禁 backdrop-filter
   （滚动列表里每帧全屏重算模糊），底面用 --gb-face-deep（不透明度 ≥.72 的
   同色渐变）撑质感。 */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #9cc0e0;
  pointer-events: auto;
  /* ③ 镜面 + ① 深蓝玻璃底 */
  background-image: var(--gb-sheen), var(--gb-face-deep);
  /* ② 上缘亮线 + 外圈发丝；chip 轻，投影只吃一层贴地的 */
  box-shadow: var(--gb-edge-hi), var(--gb-hair), 0 2rpx 8rpx rgba(0,0,0,.30);
}
.chip .n { color: #eaf4ff; font-weight: 700; }

/* —— 面板卡片 —— */
.panel {
  border-radius: 24rpx;
  padding: 32rpx;
  color: #9cc0e0;
  /* ③ + ①（深蓝款：面板默认也是压在地图上的） */
  background-image: var(--gb-sheen), var(--gb-face-deep);
  /* ② 全套边缘 + 投影 */
  box-shadow: var(--gb-edge-hi), var(--gb-edge-lo), var(--gb-hair), var(--gb-drop);
}
.panel-t {
  font-size: 30rpx;
  font-weight: 700;
  color: #eaf4ff;
  margin-bottom: 8rpx;
}
.panel-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  padding: 6rpx 0;
}

/* —— 反馈状态玻璃 ——
   ① 底面换成状态色渐变，② 描边同步换色，③ sheen 照叠。
   用法：加在 .btn / .chip / .panel 上覆盖底面。 */
.glass-ok {
  background-image: var(--gb-sheen),
    linear-gradient(180deg, rgba(52,199,123,.36), rgba(52,199,123,.22));
  box-shadow: var(--gb-edge-hi), 0 0 0 1rpx rgba(110,231,183,.42);
}
.glass-err {
  background-image: var(--gb-sheen),
    linear-gradient(180deg, rgba(255,107,107,.32), rgba(255,107,107,.20));
  box-shadow: var(--gb-edge-hi), 0 0 0 1rpx rgba(255,138,128,.42);
}

/* —— 全屏浮层 .overlay —— 全站唯一允许 backdrop-filter 的地方 ——
   红线 2：只有 WebView 渲染、背景静止的全屏浮层可用 blur(32-48rpx) saturate(180%)，
   同屏最多一层。Skyline 下 backdrop-filter 支持不完整 —— 缺了只是没了虚化，
   遮罩底色仍在，本系统本就不依赖它（镜面层是纯多背景叠加）。 */
.overlay {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(6,16,28,.45);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  backdrop-filter: blur(40rpx) saturate(180%);
}

/* —— 底部操作坞（示例页布局用，页面可自定） —— */
.dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  display: flex;
  justify-content: center;
}

/* —— 示例页脚手架（仅演示用，接进真实页面时删掉这两条） —— */
.page-demo {
  position: relative;
  min-height: 100vh;
  padding: 200rpx 24rpx 220rpx;
  box-sizing: border-box;
}
/* 地图占位：真实项目这里是持续重绘的 canvas 2d（同层渲染），垫在最底层 */
.map-holder {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: radial-gradient(120% 90% at 50% 0%, #16304f 0%, #0d1b2a 58%, #081420 100%);
}
